{
    "manifest_version": 3,
    "name": "Ledger",
    "version": "0.1.0",
    "description": "Relays the active tab to the Ledger app on this computer. Nothing leaves the device.",
    "key": "",
    "permissions": ["tabs", "nativeMessaging"],
    "background": {"service_worker": "background.js"},
    "action": {"default_popup": "popup.html"}
}
